# Password for /admin. Required in production. (Local dev falls back to "admin" with a warning.)
ADMIN_PASSWORD=change-me

# Database. Pick ONE line:
#   Local SQLite file (default, zero setup):
DATABASE_URL=file:./data/local.db
#   Turso / libSQL (SQLite in the cloud, works on Vercel):
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=...
#   Postgres / Supabase:
# DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Long random string used to sign the admin session cookie and to salt
# the short-lived rate-limit keys. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Public address of the site, used for absolute links in link previews (Open Graph).
# Leave empty locally; set it in production, e.g. https://manaviyat.example.uz
SITE_URL=
